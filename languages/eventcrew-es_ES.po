msgid "Nothing was saved: there is already a one-time text. Tick “Replace the current text” to replace it."
msgstr "No se guardó nada: ya hay un texto puntual. Marca «Reemplazar el texto actual» para reemplazarlo."

msgid "Nothing was saved: there is already a text. Tick “Replace the current text” to replace it."
msgstr "No se guardó nada: ya hay un texto. Marca «Reemplazar el texto actual» para reemplazarlo."

msgid "Replace"
msgstr "Reemplazar"

