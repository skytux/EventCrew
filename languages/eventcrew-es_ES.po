msgstr "%1$s no tiene el rol %2$s. Como organizador puedes añadirlo igualmente; recibirá el rol."

msgid "%s is blocked from sign-ups. An organizer can lift it on the People page."
msgstr "%s tiene bloqueadas las inscripciones. Un organizador puede quitar el bloqueo en la página Personas."

msgid "/assign task ; name – put a member on a task (/unassign takes them off); you confirm first"
msgstr "/assign tarea ; nombre – poner a un miembro en una tarea (/unassign lo quita); primero confirmas"

msgid "Add %1$s to %2$s?"
msgstr "¿Añadir a %1$s a %2$s?"

msgid "Add, counts"
msgstr "Añadir, cuenta"

msgid "Add, no credit"
msgstr "Añadir, sin crédito"

msgid "Cancelled. Nothing was changed."
msgstr "Cancelado. No se ha cambiado nada."

msgid "Many members match “%s”. Write more of the name."
msgstr "Muchos miembros coinciden con «%s». Escribe más del nombre."

msgid "No member called “%s” was found."
msgstr "No se encontró ningún miembro llamado «%s»."

msgid "No member called “%s” was found. Someone who is not a member yet: ➕ Add someone under /board."
msgstr "No se encontró ningún miembro llamado «%s». Alguien que aún no es miembro: ➕ Añadir a alguien en /board."

msgid "No task called “%1$s”. Tasks on %2$s: %3$s"
msgstr "No hay ninguna tarea llamada «%1$s». Tareas el %2$s: %3$s"

msgid "Organize tasks are for organizers only. Make someone an organizer with /people."
msgstr "Las tareas de Organizar son solo para organizadores. Haz organizador a alguien con /people."

msgid "Put a member on a task: /assign task ; name\nExample: /assign Host ; Milla\nA date first picks another event: /assign 21.11. Host ; Milla"
msgstr "Poner a un miembro en una tarea: /assign tarea ; nombre\nEjemplo: /assign Host ; Milla\nUna fecha delante elige otra noche: /assign 21.11. Host ; Milla"

msgid "Take %1$s off %2$s?"
msgstr "¿Quitar a %1$s de %2$s?"

msgid "Take a member off a task: /unassign task ; name\nExample: /unassign Host ; Milla\nA date first picks another event: /unassign 21.11. Host ; Milla"
msgstr "Quitar a un miembro de una tarea: /unassign tarea ; nombre\nEjemplo: /unassign Host ; Milla\nUna fecha delante elige otra noche: /unassign 21.11. Host ; Milla"

msgid "Taken off the task. If their ticket was emailed, they get an updated one; nothing else is sent."
msgstr "Quitado de la tarea. Si su entrada se envió por email, recibe una actualizada; no se envía nada más."

msgid "That person is not on this task."
msgstr "Esa persona no está en esta tarea."

msgid "That task is full (%1$d of %2$d places taken). Nothing was added."
msgstr "Esa tarea está completa (%1$d de %2$d plazas ocupadas). No se ha añadido nada."

msgid "There are no tasks on %s."
msgstr "No hay tareas el %s."

msgid "There are no upcoming tasks."
msgstr "No hay tareas próximas."

msgid "This request has expired. Please send it again."
msgstr "Esta solicitud ha caducado. Envíala de nuevo."

msgid "Use %s in a private chat with me."
msgstr "Usa %s en un chat privado conmigo."

msgid "Which member?"
msgstr "¿Qué miembro?"

msgid "%1$s has no free-entry ticket for %2$s."
msgstr "%1$s no tiene entrada gratuita para el %2$s."

msgid "%1$s has no task in the last %2$d days. Put the date first: /mark 14.11. name"
msgstr "%1$s no ha tenido ninguna tarea en los últimos %2$d días. Pon la fecha delante: /mark 14.11. nombre"

msgid "%1$s has no task on %2$s."
msgstr "%1$s no tiene tarea el %2$s."

msgid "%1$s wrote to the crew of %2$s:"
msgstr "%1$s ha escrito al equipo de %2$s:"

msgid "%d task done"
msgid_plural "%d tasks done"
msgstr[0] "%d tarea hecha"
msgstr[1] "%d tareas hechas"

msgid "%s is not blocked."
msgstr "%s no está bloqueado."

msgid "/crew – who works with you on your next nights"
msgstr "/crew – quién trabaja contigo tus próximas noches"

msgid "/freeentry close – close free entry for a night (or open)"
msgstr "/freeentry close – cerrar la entrada gratuita de una noche (u open)"

msgid "/mark name ; late – arrived, late, noshow or done"
msgstr "/mark nombre ; late – arrived, late, noshow o done"

msgid "/name, /email – change your name or email"
msgstr "/name, /email – cambiar tu nombre o email"

msgid "/newboard – post a new board in the group"
msgstr "/newboard – publicar un tablón nuevo en el grupo"

msgid "/newcomer – a newcomer waiting for your OK"
msgstr "/newcomer – una persona nueva que espera tu OK"

msgid "/sendtickets – send the ticket emails now (or cancel)"
msgstr "/sendtickets – enviar ya los emails de entradas (o cancel)"

msgid "/standing name – standing, credits and log"
msgstr "/standing nombre – fiabilidad, créditos e historial"

msgid "/stop announcement or /stop email – stop the next send"
msgstr "/stop announcement o /stop email – detener el próximo envío"

msgid "/tell task ; message sends your message to everyone on that task: by Telegram in their own language, under a one-line header, or by email when they have no Telegram. You see it first. You can send 5 an hour."
msgstr "/tell tarea ; mensaje envía tu mensaje a todos los de esa tarea: por Telegram en su propio idioma, bajo una cabecera de una línea, o por email si no tienen Telegram. Tú lo ves primero. Puedes enviar 5 por hora."

msgid "/tell task ; text – message everyone on a task"
msgstr "/tell tarea ; texto – escribir a todos los de una tarea"

msgid "/ticket name – free entry for a credit (/unticket undoes it)"
msgstr "/ticket nombre – entrada gratuita a cambio de un crédito (/unticket lo deshace)"

msgid "/unban name – lift a block"
msgstr "/unban nombre – quitar un bloqueo"

msgid "A link is on its way to %s. Your email changes when you open it."
msgstr "Va un enlace de camino a %s. Tu email cambia cuando lo abras."

msgid "A task can be marked on its day or later."
msgstr "Una tarea se puede marcar el mismo día o después."

msgid "Blocked from sign-ups."
msgstr "Inscripciones bloqueadas."

msgid "Cancel a free-entry ticket: /unticket name\nExample: /unticket Milla\nA date first picks another night: /unticket 21.11. Milla"
msgstr "Cancelar una entrada gratuita: /unticket nombre\nEjemplo: /unticket Milla\nUna fecha delante elige otra noche: /unticket 21.11. Milla"

msgid "Cancel send"
msgstr "Cancelar envío"

msgid "Cancel the free-entry ticket of %1$s for %2$s? The credit goes back."
msgstr "¿Cancelar la entrada gratuita de %1$s para el %2$s? El crédito se devuelve."

msgid "Cancel this send?"
msgstr "¿Cancelar este envío?"

msgid "Cancel ticket"
msgstr "Cancelar entrada"

msgid "Change"
msgstr "Cambiar"

msgid "Change your email to %s? A link goes there first; the email changes when you open it."
msgstr "¿Cambiar tu email a %s? Primero se envía allí un enlace; el email cambia cuando lo abras."

msgid "Change your name from %1$s to %2$s?"
msgstr "¿Cambiar tu nombre de %1$s a %2$s?"

msgid "Close free entry for %s? Nobody can use a credit for that night."
msgstr "¿Cerrar la entrada gratuita del %s? Nadie podrá usar un crédito para esa noche."

msgid "Close or reopen free entry: /freeentry close or /freeentry open\nA date first picks another night: /freeentry 21.11. close"
msgstr "Cerrar o reabrir la entrada gratuita: /freeentry close o /freeentry open\nUna fecha delante elige otra noche: /freeentry 21.11. close"

msgid "Commands in a private chat"
msgstr "Comandos en un chat privado"

msgid "Credits:"
msgstr "Créditos:"

msgid "Every member can use /crew to see who works with them on their next nights, and /name or /email to change their own name or email. A new email changes only after they open the link sent to it."
msgstr "Cada miembro puede usar /crew para ver quién trabaja con él sus próximas noches, y /name o /email para cambiar su propio nombre o email. Un email nuevo solo cambia después de abrir el enlace que se le envía."

msgid "For a night: /freeentry close or /freeentry open closes or reopens free entry. /stop announcement stops the next announcement, /stop email the post-event email. /newboard posts a new board in the group. /sendtickets sends the ticket emails now, /sendtickets cancel stops a waiting send."
msgstr "Para una noche: /freeentry close o /freeentry open cierra o reabre la entrada gratuita. /stop announcement detiene el próximo anuncio, /stop email el email posterior al evento. /newboard publica un tablón nuevo en el grupo. /sendtickets envía ya los emails de entradas, /sendtickets cancel detiene un envío pendiente."

msgid "For a person: /mark name ; arrived, late, noshow or done sets the roster mark. /standing name shows standing, credits and log. /newcomer shows a newcomer waiting for your OK. /ticket name spends a credit on free entry, /unticket name gives it back. /unban name lifts a block."
msgstr "Para una persona: /mark nombre ; arrived, late, noshow o done pone la marca de asistencia. /standing nombre muestra fiabilidad, créditos e historial. /newcomer muestra una persona nueva que espera tu OK. /ticket nombre gasta un crédito en entrada gratuita, /unticket nombre lo devuelve. /unban nombre quita un bloqueo."

#. translators: 1: a person's name, 2: a short day label, 3: credits they have now.
msgid "Free entry for %1$s on %2$s? It uses 1 of their %3$d credit."
msgid_plural "Free entry for %1$s on %2$s? It uses 1 of their %3$d credits."
msgstr[0] "¿Entrada gratuita para %1$s el %2$s? Usa 1 crédito (tiene %3$d)."
msgstr[1] "¿Entrada gratuita para %1$s el %2$s? Usa 1 crédito (tiene %3$d)."

msgid "Free entry for a credit: /ticket name\nExample: /ticket Milla\nA date first picks another night: /ticket 21.11. Milla"
msgstr "Entrada gratuita a cambio de un crédito: /ticket nombre\nEjemplo: /ticket Milla\nUna fecha delante elige otra noche: /ticket 21.11. Milla"

msgid "Free entry is closed by the event itself (sold out, hidden or off). Change it in the event."
msgstr "La entrada gratuita está cerrada por el propio evento (agotado, oculto o desactivado). Cámbialo en el evento."

msgid "Free entry is open for this date."
msgstr "La entrada gratuita está abierta para esta fecha."

msgid "Give ticket"
msgstr "Dar entrada"

msgid "In a private chat with the bot you can do several crew page tasks by command. Write the name as you remember it: the bot finds the person, asks with buttons when several fit, and shows every change with ✅ and ✖️ first. A date first, like /mark 14.11. Milla ; done, picks another night."
msgstr "En un chat privado con el bot puedes hacer por comando varias cosas de la página del equipo. Escribe el nombre como lo recuerdes: el bot encuentra a la persona, pregunta con botones si encajan varias y muestra antes cada cambio con ✅ y ✖️. Una fecha delante, como /mark 14.11. Milla ; done, elige otra noche."

msgid "Lift a block: /unban name\nExample: /unban Milla"
msgstr "Quitar un bloqueo: /unban nombre\nEjemplo: /unban Milla"

msgid "Lift block"
msgstr "Quitar bloqueo"

msgid "Lift the block on %s? They can sign in and sign up again."
msgstr "¿Quitar el bloqueo a %s? Podrá volver a iniciar sesión e inscribirse."

msgid "Mark"
msgstr "Marcar"

msgid "Mark a task: /mark name ; arrived, late, noshow or done\nExample: /mark Milla ; late\nA date first picks another night: /mark 14.11. Milla ; done"
msgstr "Marcar una tarea: /mark nombre ; arrived, late, noshow o done\nEjemplo: /mark Milla ; late\nUna fecha delante elige otra noche: /mark 14.11. Milla ; done"

msgid "Mark as “%s”?"
msgstr "¿Marcar como «%s»?"

msgid "Message everyone on a task: /tell task ; message\nExample: /tell Bar ; Please come 15 minutes early.\nA date first picks another event: /tell 21.11. Bar ; …"
msgstr "Escribir a todos los de una tarea: /tell tarea ; mensaje\nEjemplo: /tell Bar ; Venid 15 minutos antes, por favor.\nUna fecha delante elige otra noche: /tell 21.11. Bar ; …"

msgid "Message from %1$s: %2$s"
msgstr "Mensaje de %1$s: %2$s"

msgid "No announcement is planned."
msgstr "No hay ningún anuncio previsto."

msgid "No blocked member called “%s” was found."
msgstr "No se ha encontrado ningún miembro bloqueado llamado «%s»."

msgid "No newcomer called “%s” is waiting."
msgstr "No hay ninguna persona nueva llamada «%s» esperando."

msgid "No newcomer is waiting for an OK."
msgstr "Ninguna persona nueva espera un OK."

msgid "No post-event email is planned."
msgstr "No hay ningún email posterior al evento previsto."

msgid "No task called “%s” was found."
msgstr "No se ha encontrado ninguna tarea llamada «%s»."

msgid "Nobody else is on %s."
msgstr "No hay nadie más en %s."

msgid "Now: %s"
msgstr "Ahora: %s"

msgid "Only organizers can use %s."
msgstr "Solo los organizadores pueden usar %s."

msgid "Post"
msgstr "Publicar"

msgid "Post a new board in the group? The old one is removed."
msgstr "¿Publicar un tablón nuevo en el grupo? El anterior se borra."

msgid "Recent tasks:"
msgstr "Tareas recientes:"

msgid "Reopen"
msgstr "Reabrir"

msgid "Reopen free entry for %s?"
msgstr "¿Reabrir la entrada gratuita del %s?"

msgid "Send"
msgstr "Enviar"

msgid "Send link"
msgstr "Enviar enlace"

msgid "Send the night’s ticket emails now: /sendtickets (or /sendtickets 21.11.)\nCancel the waiting send: /sendtickets cancel"
msgstr "Enviar ya los emails de entradas de la noche: /sendtickets (o /sendtickets 21.11.)\nCancelar el envío pendiente: /sendtickets cancel"

#. translators: %s: a short day label, like "Sat 14 Nov".
msgid "Send the ticket emails for %s that have not gone out? They go out in about 10 minutes; until then you can cancel them."
msgstr "¿Enviar los emails de entradas del %s que aún no han salido? Salen en unos 10 minutos; hasta entonces puedes cancelarlos."

#. translators: 1: number of people, 2: a task with its day and time.
msgid "Send this to %1$d person on %2$s?"
msgid_plural "Send this to %1$d people on %2$s?"
msgstr[0] "¿Enviar esto a %1$d persona de %2$s?"
msgstr[1] "¿Enviar esto a %1$d personas de %2$s?"

#. translators: 1: people the message went to, 2: of them on Telegram, 3: of them by email.
msgid "Sent to %1$d person (Telegram %2$d, email %3$d)."
msgid_plural "Sent to %1$d people (Telegram %2$d, email %3$d)."
msgstr[0] "Enviado a %1$d persona (Telegram %2$d, email %3$d)."
msgstr[1] "Enviado a %1$d personas (Telegram %2$d, email %3$d)."

msgid "Someone’s standing, credits and log: /standing name\nExample: /standing Milla"
msgstr "Fiabilidad, créditos e historial de alguien: /standing nombre\nEjemplo: /standing Milla"

msgid "Stop"
msgstr "Detener"

msgid "Stop the announcement planned for %s? It will not be sent."
msgstr "¿Detener el anuncio previsto para el %s? No se enviará."

msgid "Stop the next announcement: /stop announcement\nStop the post-event email: /stop email (or /stop email 14.11.)"
msgstr "Detener el próximo anuncio: /stop announcement\nDetener el email posterior al evento: /stop email (o /stop email 14.11.)"

msgid "Stop the post-event email for %s? It will not be sent."
msgstr "¿Detener el email posterior al evento del %s? No se enviará."

msgid "That is already your email."
msgstr "Ese ya es tu email."

msgid "That is already your name."
msgstr "Ese ya es tu nombre."

msgid "That is not a valid email address."
msgstr "Esa no es una dirección de email válida."

msgid "That message is too long. At most %d characters."
msgstr "Ese mensaje es demasiado largo. Como máximo %d caracteres."

msgid "Waiting for an OK."
msgstr "Esperando un OK."

msgid "Which newcomer?"
msgstr "¿Qué persona nueva?"

msgid "You asked for a link a few times already. Try again in an hour."
msgstr "Ya has pedido un enlace varias veces. Vuelve a intentarlo dentro de una hora."

#. translators: %d: how many messages an organizer may send in an hour.
msgid "You can send %d messages an hour. Try again later."
msgstr "Puedes enviar %d mensajes por hora. Vuelve a intentarlo más tarde."

msgid "You have no coming tasks. See the open ones with /board."
msgstr "No tienes próximas tareas. Mira las abiertas con /board."

msgid "Your email: %s\nChange it: /email new@example.com"
msgstr "Tu email: %s\nCambiarlo: /email new@example.com"

msgid "Your name is now %s."
msgstr "Ahora tu nombre es %s."

msgid "Your name: %s\nChange it: /name New Name"
msgstr "Tu nombre: %s\nCambiarlo: /name Nombre Nuevo"

