msgid "Nothing was saved: there is already a one-time text. Tick “Replace the current text” to replace it."
msgstr "Rien n’a été enregistré : il y a déjà un texte ponctuel. Cochez « Remplacer le texte actuel » pour le remplacer."

msgid "Nothing was saved: there is already a text. Tick “Replace the current text” to replace it."
msgstr "Rien n’a été enregistré : il y a déjà un texte. Cochez « Remplacer le texte actuel » pour le remplacer."

msgid "Replace"
msgstr "Remplacer"

msgid "Replace it with your text?"
msgstr "Le remplacer par votre texte ?"

msgid "Replace the current text"
