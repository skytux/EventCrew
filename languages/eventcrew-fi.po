msgstr "Vain sähköpostit"

#, php-format
msgid "The settings were saved, but these language codes are not known and were left out: %s."
msgstr "Asetukset tallennettiin, mutta näitä kielikoodeja ei tunneta, joten ne jätettiin pois: %s."

msgid "The language settings were saved."
msgstr "Kieliasetukset tallennettiin."

msgid "This text was not found. Nothing was saved."
msgstr "Tekstiä ei löytynyt. Mitään ei tallennettu."

msgid "Nothing was saved."
msgstr "Mitään ei tallennettu."

#, php-format
