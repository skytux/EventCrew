msgid "%1$s (%2$s) wrote to the bot in a private chat. Here is that chat, oldest first."
msgstr "%1$s (%2$s) ha scritto al bot in una chat privata. Ecco la chat, dal messaggio più vecchio."

#. translators: 1: holder's name, 2: role, 3: event, 4: date/time
msgid "%1$s agreed, but their task could not be moved to you: %2$s at %3$s, %4$s. Nothing changed."
msgstr "%1$s ha accettato, ma non è stato possibile passarti il suo incarico: %2$s a %3$s, %4$s. Non è cambiato nulla."

#. translators: 1: holder's name, 2: role, 3: event, 4: date/time
msgid "%1$s did not answer in time, so they keep their task: %2$s at %3$s, %4$s."
msgstr "%1$s non ha risposto in tempo, quindi tiene il suo incarico: %2$s a %3$s, %4$s."

#. translators: 1: cover's name, 2: person being covered, 3: role, 4: event
msgid "%1$s is covering for %2$s: %3$s at %4$s."
msgstr "%1$s sostituisce %2$s: %3$s a %4$s."

#. translators: 1: holder's name, 2: role, 3: event, 4: date/time
msgid "%1$s keeps their task: %2$s at %3$s, %4$s. Your request to take it over was declined."
msgstr "%1$s tiene il suo incarico: %2$s a %3$s, %4$s. La tua richiesta di subentrare è stata rifiutata."

msgid "%1$s no longer has the role %2$s."
msgstr "%1$s non ha più il ruolo %2$s."

msgid "%1$s now has the role %2$s."
msgstr "%1$s ora ha il ruolo %2$s."

#. translators: 1: the person's name, 2: the role
msgid "%1$s now meets the conditions for the role %2$s. You can give them the role with /people."
msgstr "%1$s ora soddisfa le condizioni per il ruolo %2$s. Puoi assegnargli il ruolo con /people."

#. translators: 1: the person's name, 2: the role, 3: the name of the organizer who gave it
msgid "%1$s was given the role %2$s by %3$s."
msgstr "%1$s ha ricevuto il ruolo %2$s da %3$s."

#. translators: 1: the person's name, 2: the role
msgid "%1$s was given the role %2$s."
msgstr "%1$s ha ricevuto il ruolo %2$s."

#. translators: 1: the person's name, 2: the name of the organizer who did it
