msgid "   buttons: 🎟 free-entry ticket, 🔁 take over a task, 🔑 web sign-in, 🔔 notifications, 🌐 language"
msgstr "   pulsanti: 🎟 biglietto d'ingresso gratuito, 🔁 subentra in un incarico, 🔑 accesso web, 🔔 notifiche, 🌐 lingua"

msgid " and "
msgstr " e "

msgid "\"Opens the sales desk\": the people on that night’s task of this role are the welcome crew. Once marked arrived they get the sales desk link, can see who has a ticket and the guest list, and can mark the crew with /roster."
msgstr "\"Apre la cassa\": le persone con l’incarico di questo ruolo quella sera sono la crew di accoglienza. Una volta segnate come arrivate ricevono il link della cassa, possono vedere chi ha un biglietto e la lista ospiti, e possono segnare la crew con /roster."

#. translators: 1: number of guests added, 2: the event day, e.g. "Sat 1 Aug"
msgid "%1$d guests were added to the guest list for %2$s."
msgstr "%1$d ospiti sono stati aggiunti alla lista ospiti per %2$s."

msgid "%1$d of %2$d"
msgstr "%1$d di %2$d"

#. translators: 1: events posted, 2: events in the preview
msgid "%1$d of %2$d events were posted in the group. The others could not be posted."
msgstr "%1$d eventi su %2$d sono stati pubblicati nel gruppo. Gli altri non è stato possibile pubblicarli."

#. translators: 1: number of tasks created, 2: how many of them have no times
msgid "%1$d task created, %2$d without times - the role has no offsets, or the event has no end recorded."
msgid_plural "%1$d tasks created, %2$d without times - those roles have no offsets, or the event has no end recorded."
msgstr[0] "%1$d incarico creato, %2$d senza orari - il ruolo non ha scostamenti, o l’evento non ha un orario di fine."
msgstr[1] "%1$d incarichi creati, %2$d senza orari - quei ruoli non hanno scostamenti, o l’evento non ha un orario di fine."

#. translators: 1: number of names added, 2: number of names skipped
msgid "%1$d ticket buyers added, %2$d skipped (already on the list)."
msgstr "%1$d acquirenti di biglietti aggiunti, %2$d saltati (già in lista)."

#. translators: 1: number of tickets added, 2: the event day, e.g. "Sat 1 Aug"
msgid "%1$d tickets were imported for %2$s."
msgstr "%1$d biglietti sono stati importati per %2$s."

#. translators: 1: recent-task list, 2: total completed
msgid "%1$s\n\nTasks completed in total: %2$d."
msgstr "%1$s\n\nIncarichi completati in totale: %2$d."

#. translators: 1: person's name, 2: their current credit balance
msgid "%1$s (%2$d credit now)"
msgid_plural "%1$s (%2$d credits now)"
msgstr[0] "%1$s (ora %2$d credito)"
msgstr[1] "%1$s (ora %2$d crediti)"

#. translators: 1: person name, 2: credit balance
msgid "%1$s (%2$d credits)"
msgstr "%1$s (%2$d crediti)"

