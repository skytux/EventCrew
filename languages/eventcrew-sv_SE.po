msgid "Shown under the home-screen icon, 12 characters at most. Blank uses the app name if it fits, else its initials and “Crew”."
msgstr "Visas under ikonen på hemskärmen, högst 12 tecken. Tomt använder appens namn om det får plats, annars initialerna och ”Crew”."

msgid "Signup confirmations and task reminders are always sent on every channel."
msgstr "Bekräftelser på anmälan och påminnelser om uppgifter skickas alltid i alla kanaler."

msgid "🔔 Your notifications — tap to toggle 📱 Telegram, ✉ email or 🔔 app.\n\nSignup confirmations and task reminders always send on every channel."
msgstr "🔔 Dina aviseringar — tryck för att slå på/av 📱 Telegram, ✉ e-post eller 🔔 app.\n\nAnmälningsbekräftelser och påminnelser om uppgifter skickas alltid via alla kanaler."

msgctxt "notification channel"
msgid "App"
msgstr "App"

msgid "Turn on notifications on this device"
msgstr "Slå på aviseringar på den här enheten"

msgid "Turn off notifications on this device"
msgstr "Stäng av aviseringar på den här enheten"

msgid "Notifications are blocked for this site. Allow them in the browser settings."
msgstr "Aviseringar är blockerade för den här webbplatsen. Tillåt dem i webbläsarens inställningar."

msgid "On iPhone, notifications work after you add this page to your Home Screen."
msgstr "På iPhone fungerar aviseringar när du har lagt till sidan på hemskärmen."

msgid "Could not turn on notifications. Try again."
msgstr "Det gick inte att slå på aviseringar. Försök igen."

#. translators: %s: the app's short name, like "EDH Crew".
msgid "Get the %s app"
msgstr "Skaffa appen %s"

msgid "Useful notifications you choose. No need for Telegram."
msgstr "Nyttiga aviseringar som du väljer. Telegram behövs inte."

msgid "Remind me later"
msgstr "Påminn mig senare"

msgid "Add it to your Home Screen"
msgstr "Lägg till den på hemskärmen"

msgid "Tap Share in the browser bar."
msgstr "Tryck på Dela i webbläsarfältet."

msgid "Choose Add to Home Screen."
msgstr "Välj Lägg till på hemskärmen."

#. translators: %s: the app's short name, like "EDH Crew".
msgid "Open %s from your Home Screen."
msgstr "Öppna %s från hemskärmen."

msgid "Turn on notifications"
msgstr "Slå på aviseringar"

msgid "Then choose which notices reach you in the app."
msgstr "Välj sedan vilka aviseringar du får i appen."

msgid "Remind about the app after"
msgstr "Påminn om appen efter"

msgid "Signed-in people who have not installed the Crew app see a pop-in offering it. Remind me later hides it for this many days."
msgstr "Inloggade som inte har installerat Crew-appen ser en ruta som erbjuder den. Påminn mig senare döljer den så här många dagar."
