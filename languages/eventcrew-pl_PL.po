msgstr "Zaoferować twój bilet na %2$s dla %1$s? Musi go przyjąć przed otwarciem drzwi. Do tego czasu twój bilet działa."

#: src/Telegram/TransferPage.php:325
msgid "Pick the member who gets your ticket. It moves at once and your own ticket stops working."
msgstr "Wybierz członka, który dostanie twój bilet. Przejdzie od razu, a twój bilet przestanie działać."

#: src/Support/TicketTransferService.php:467
msgid "Please write your name."
msgstr "Wpisz swoje imię."

#: src/Telegram/TransferPage.php:251
msgid "Send the offer"
msgstr "Wyślij ofertę"

#: src/Telegram/TransferBot.php:289 src/Telegram/TransferPage.php:202
#. translators: %s: an email address
msgid "Sent. When %s accepts, the ticket moves to them. Until then your own ticket works."
msgstr "Wysłano. Gdy %s przyjmie bilet, przejdzie on na tę osobę. Do tego czasu twój bilet działa."

#: src/Support/TicketTransferService.php:496
msgid "Someone"
msgstr "Ktoś"

#: src/Support/TicketMail.php:1790
msgid "Someone gave you their free-entry ticket."
msgstr "Ktoś dał ci swój darmowy bilet."

#: src/Support/TicketTransferService.php:464
msgid "That is not an email address. Write a name or an email address."
msgstr "To nie jest adres e-mail. Wpisz imię albo adres e-mail."

#: src/Support/TicketTransferService.php:463
msgid "That is you. Pick someone else."
msgstr "To ty. Wybierz kogoś innego."

#: src/Support/TicketTransferService.php:466
msgid "The doors are already open. Give the ticket to a member instead."
msgstr "Drzwi są już otwarte. Oddaj bilet członkowi."

#: src/Support/PrivacyEraser.php:120
msgid "The name and email address were erased from the free-entry tickets given to this address. The tickets stay on the door list with no name."
msgstr "Imię i adres e-mail usunięto z darmowych biletów przekazanych na ten adres. Bilety zostają na liście wejść bez imienia."

#: src/Support/TicketTransferService.php:369
#. translators: %s: the night, like "Sat 14 Nov · Dance Night"
msgid "The organizers cancelled the free-entry ticket you were given for %s."
msgstr "Organizatorzy anulowali darmowy bilet, który dostałeś(-aś) na %s."

#: src/Telegram/TransferPage.php:419
#. translators: %s: an email address
msgid "The ticket is yours. We emailed it to %s."
msgstr "Bilet jest twój. Wysłaliśmy go na %s."

#: src/Support/TicketTransferService.php:468
msgid "This offer is no longer open."
msgstr "Ta oferta jest już nieaktualna."

#: src/Support/TicketTransferService.php:469
msgid "This ticket cannot be given away."
msgstr "Tego biletu nie można oddać."

#: src/Support/TicketTransferService.php:462
msgid "This ticket is already offered to someone. Cancel that offer first."
msgstr "Ten bilet jest już komuś zaoferowany. Najpierw anuluj tę ofertę."

