msgid "Each extra task on the same night earns one more credit. It shows as pending and is added after the event, if you did the task."
msgstr "Elke extra taak op dezelfde avond levert één credit meer op. Die staat in afwachting en wordt na het evenement toegevoegd, als je de taak hebt gedaan."

#. translators: %s: the date of the night
#: src/Support/ExtraTaskCredits.php
msgid "Extra task on %s"
msgstr "Extra taak op %s"

#: templates/admin/settings.php
