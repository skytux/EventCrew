msgstr "Bedankt dat je een taak neemt en deze avond mogelijk maakt. Geniet ook van het dansen als onze gast!"

#: src/Support/TicketReasons.php
msgid "Thank you for being part of the crew and helping make these nights happen. This one is on us: come dance and enjoy it as our guest!"
msgstr "Bedankt dat je deel uitmaakt van de crew en deze avonden mogelijk maakt. Deze avond trakteren wij: kom dansen en geniet ervan als onze gast!"

msgid "%1$s does not have the %2$s role. As an organizer you can still add them; they get the role."
msgstr "%1$s heeft de rol %2$s niet. Als organisator kun je diegene toch toevoegen; die krijgt dan de rol."

msgid "%s is blocked from sign-ups. An organizer can lift it on the People page."
msgstr "%s is geblokkeerd voor aanmeldingen. Een organisator kan dat opheffen op de pagina Mensen."

msgid "/assign task ; name – put a member on a task (/unassign takes them off); you confirm first"
msgstr "/assign taak ; naam – een lid op een taak zetten (/unassign haalt het eraf); je bevestigt eerst"

msgid "Add %1$s to %2$s?"
msgstr "%1$s toevoegen aan %2$s?"

msgid "Add, counts"
msgstr "Toevoegen, telt"

msgid "Add, no credit"
msgstr "Toevoegen, zonder credit"

msgid "Cancelled. Nothing was changed."
msgstr "Geannuleerd. Er is niets veranderd."

msgid "Many members match “%s”. Write more of the name."
msgstr "Veel leden passen bij ‘%s’. Schrijf meer van de naam."

msgid "No member called “%s” was found."
msgstr "Geen lid met de naam ‘%s’ gevonden."

msgid "No member called “%s” was found. Someone who is not a member yet: ➕ Add someone under /board."
msgstr "Geen lid met de naam ‘%s’ gevonden. Iemand die nog geen lid is: ➕ Iemand toevoegen onder /board."

msgid "No task called “%1$s”. Tasks on %2$s: %3$s"
msgstr "Geen taak met de naam ‘%1$s’. Taken op %2$s: %3$s"

msgid "Put a member on a task: /assign task ; name\nExample: /assign Host ; Milla\nA date first picks another event: /assign 21.11. Host ; Milla"
msgstr "Een lid op een taak zetten: /assign taak ; naam\nVoorbeeld: /assign Host ; Milla\nEen datum vooraan kiest een andere avond: /assign 21.11. Host ; Milla"

msgid "Take %1$s off %2$s?"
msgstr "%1$s van %2$s halen?"

msgid "Take a member off a task: /unassign task ; name\nExample: /unassign Host ; Milla\nA date first picks another event: /unassign 21.11. Host ; Milla"
msgstr "Een lid van een taak halen: /unassign taak ; naam\nVoorbeeld: /unassign Host ; Milla\nEen datum vooraan kiest een andere avond: /unassign 21.11. Host ; Milla"

msgid "Taken off the task. If their ticket was emailed, they get an updated one; nothing else is sent."
msgstr "Van de taak gehaald. Als het ticket per e-mail is gestuurd, komt er een bijgewerkt ticket; verder wordt niets gestuurd."

msgid "That person is not on this task."
msgstr "Die persoon staat niet op deze taak."

msgid "That task is full (%1$d of %2$d places taken). Nothing was added."
msgstr "Die taak is vol (%1$d van %2$d plaatsen bezet). Er is niets toegevoegd."

msgid "There are no tasks on %s."
msgstr "Er zijn geen taken op %s."

msgid "There are no upcoming tasks."
msgstr "Er zijn geen komende taken."

msgid "This request has expired. Please send it again."
msgstr "Dit verzoek is verlopen. Stuur het opnieuw."

msgid "Use %s in a private chat with me."
msgstr "Gebruik %s in een privéchat met mij."

msgid "Which member?"
msgstr "Welk lid?"

msgid "%1$s has no free-entry ticket for %2$s."
msgstr "%1$s heeft geen gratis ticket voor %2$s."

msgid "%1$s has no task in the last %2$d days. Put the date first: /mark 14.11. name"
msgstr "%1$s had de afgelopen %2$d dagen geen taak. Zet de datum vooraan: /mark 14.11. naam"

msgid "%1$s has no task on %2$s."
msgstr "%1$s heeft geen taak op %2$s."

msgid "%1$s wrote to the crew of %2$s:"
msgstr "%1$s schreef aan de crew van %2$s:"

msgid "%d task done"
msgid_plural "%d tasks done"
msgstr[0] "%d taak gedaan"
msgstr[1] "%d taken gedaan"

msgid "%s is not blocked."
msgstr "%s is niet geblokkeerd."

msgid "/crew – who works with you on your next nights"
msgstr "/crew – wie er op je volgende avonden met je werkt"

msgid "/freeentry close – close free entry for a night (or open)"
msgstr "/freeentry close – gratis toegang voor een avond sluiten (of open)"

msgid "/mark name ; late – arrived, late, noshow or done"
msgstr "/mark naam ; late – arrived, late, noshow of done"

msgid "/name, /email – change your name or email"
msgstr "/name, /email – je naam of e-mail wijzigen"

msgid "/newboard – post a new board in the group"
msgstr "/newboard – een nieuw takenbord in de groep plaatsen"

msgid "/newcomer – a newcomer waiting for your OK"
msgstr "/newcomer – een nieuwkomer die op je OK wacht"

msgid "/sendtickets – send the ticket emails now (or cancel)"
msgstr "/sendtickets – de ticketmails nu versturen (of cancel)"

msgid "/standing name – standing, credits and log"
msgstr "/standing naam – status, credits en logboek"

msgid "/stop announcement or /stop email – stop the next send"
msgstr "/stop announcement of /stop email – de volgende verzending stoppen"

msgid "/tell task ; message sends your message to everyone on that task: by Telegram in their own language, under a one-line header, or by email when they have no Telegram. You see it first. You can send 5 an hour."
msgstr "/tell taak ; bericht stuurt je bericht naar iedereen op die taak: via Telegram in hun eigen taal, onder een kopregel, of per e-mail als ze geen Telegram hebben. Je ziet het eerst. Je kunt er 5 per uur sturen."

msgid "/tell task ; text – message everyone on a task"
msgstr "/tell taak ; tekst – iedereen op een taak een bericht sturen"

msgid "/ticket name – free entry for a credit (/unticket undoes it)"
msgstr "/ticket naam – gratis toegang voor een credit (/unticket maakt het ongedaan)"

msgid "/unban name – lift a block"
msgstr "/unban naam – een blokkering opheffen"

msgid "A link is on its way to %s. Your email changes when you open it."
msgstr "Er is een link onderweg naar %s. Je e-mail verandert als je hem opent."

msgid "A task can be marked on its day or later."
msgstr "Een taak kan op de dag zelf of later gemarkeerd worden."

msgid "Blocked from sign-ups."
msgstr "Geblokkeerd voor aanmeldingen."

msgid "Cancel a free-entry ticket: /unticket name\nExample: /unticket Milla\nA date first picks another night: /unticket 21.11. Milla"
msgstr "Een gratis ticket annuleren: /unticket naam\nVoorbeeld: /unticket Milla\nEen datum vooraan kiest een andere avond: /unticket 21.11. Milla"

msgid "Cancel send"
msgstr "Verzending annuleren"

msgid "Cancel the free-entry ticket of %1$s for %2$s? The credit goes back."
msgstr "Het gratis ticket van %1$s voor %2$s annuleren? De credit komt terug."

msgid "Cancel this send?"
msgstr "Deze verzending annuleren?"

msgid "Cancel ticket"
msgstr "Ticket annuleren"

msgid "Change"
msgstr "Wijzigen"

msgid "Change your email to %s? A link goes there first; the email changes when you open it."
msgstr "Je e-mail wijzigen in %s? Eerst gaat er een link naartoe; de e-mail verandert als je hem opent."

msgid "Change your name from %1$s to %2$s?"
msgstr "Je naam wijzigen van %1$s in %2$s?"

msgid "Close free entry for %s? Nobody can use a credit for that night."
msgstr "Gratis toegang voor %s sluiten? Niemand kan dan een credit gebruiken voor die avond."

msgid "Close or reopen free entry: /freeentry close or /freeentry open\nA date first picks another night: /freeentry 21.11. close"
msgstr "Gratis toegang sluiten of weer openen: /freeentry close of /freeentry open\nEen datum vooraan kiest een andere avond: /freeentry 21.11. close"

msgid "Commands in a private chat"
msgstr "Commando’s in een privéchat"

msgid "Credits:"
msgstr "Credits:"

msgid "Every member can use /crew to see who works with them on their next nights, and /name or /email to change their own name or email. A new email changes only after they open the link sent to it."
msgstr "Elk lid kan met /crew zien wie er op zijn volgende avonden met hem werkt, en met /name of /email zijn eigen naam of e-mail wijzigen. Een nieuw e-mailadres geldt zodra de link die ernaartoe is gestuurd, is geopend."

msgid "For a night: /freeentry close or /freeentry open closes or reopens free entry. /stop announcement stops the next announcement, /stop email the post-event email. /newboard posts a new board in the group. /sendtickets sends the ticket emails now, /sendtickets cancel stops a waiting send."
msgstr "Voor een avond: /freeentry close of /freeentry open sluit gratis toegang of opent die weer. /stop announcement stopt de volgende aankondiging, /stop email de e-mail na het evenement. /newboard plaatst een nieuw takenbord in de groep. /sendtickets verstuurt de ticketmails meteen, /sendtickets cancel stopt een wachtende verzending."

msgid "For a person: /mark name ; arrived, late, noshow or done sets the roster mark. /standing name shows standing, credits and log. /newcomer shows a newcomer waiting for your OK. /ticket name spends a credit on free entry, /unticket name gives it back. /unban name lifts a block."
msgstr "Voor een persoon: /mark naam ; arrived, late, noshow of done zet de aanwezigheidsmarkering. /standing naam toont status, credits en logboek. /newcomer toont een nieuwkomer die op je OK wacht. /ticket naam besteedt een credit aan gratis toegang, /unticket naam geeft hem terug. /unban naam heft een blokkering op."

#. translators: 1: a person's name, 2: a short day label, 3: credits they have now.
msgid "Free entry for %1$s on %2$s? It uses 1 of their %3$d credit."
msgid_plural "Free entry for %1$s on %2$s? It uses 1 of their %3$d credits."
msgstr[0] "Gratis toegang voor %1$s op %2$s? Dat kost 1 credit (heeft er nu %3$d)."
msgstr[1] "Gratis toegang voor %1$s op %2$s? Dat kost 1 credit (heeft er nu %3$d)."

msgid "Free entry for a credit: /ticket name\nExample: /ticket Milla\nA date first picks another night: /ticket 21.11. Milla"
msgstr "Gratis toegang voor een credit: /ticket naam\nVoorbeeld: /ticket Milla\nEen datum vooraan kiest een andere avond: /ticket 21.11. Milla"

msgid "Free entry is closed by the event itself (sold out, hidden or off). Change it in the event."
msgstr "Gratis toegang is gesloten door het evenement zelf (uitverkocht, verborgen of uit). Wijzig het in het evenement."

msgid "Free entry is open for this date."
msgstr "Gratis toegang is open voor deze datum."

msgid "Give ticket"
msgstr "Ticket geven"

msgid "In a private chat with the bot you can do several crew page tasks by command. Write the name as you remember it: the bot finds the person, asks with buttons when several fit, and shows every change with ✅ and ✖️ first. A date first, like /mark 14.11. Milla ; done, picks another night."
msgstr "In een privéchat met de bot kun je een aantal dingen van de crewpagina met een commando doen. Schrijf de naam zoals je die onthouden hebt: de bot vindt de persoon, vraagt met knoppen als er meerdere passen, en toont elke wijziging eerst met ✅ en ✖️. Een datum vooraan, zoals /mark 14.11. Milla ; done, kiest een andere avond."

msgid "Lift a block: /unban name\nExample: /unban Milla"
msgstr "Een blokkering opheffen: /unban naam\nVoorbeeld: /unban Milla"

msgid "Lift block"
msgstr "Deblokkeren"

msgid "Lift the block on %s? They can sign in and sign up again."
msgstr "De blokkering van %s opheffen? Diegene kan weer inloggen en zich aanmelden."

msgid "Mark"
msgstr "Markeren"

msgid "Mark a task: /mark name ; arrived, late, noshow or done\nExample: /mark Milla ; late\nA date first picks another night: /mark 14.11. Milla ; done"
msgstr "Een taak markeren: /mark naam ; arrived, late, noshow of done\nVoorbeeld: /mark Milla ; late\nEen datum vooraan kiest een andere avond: /mark 14.11. Milla ; done"

msgid "Mark as “%s”?"
msgstr "Markeren als ‘%s’?"

msgid "Message everyone on a task: /tell task ; message\nExample: /tell Bar ; Please come 15 minutes early.\nA date first picks another event: /tell 21.11. Bar ; …"
msgstr "Iedereen op een taak een bericht sturen: /tell taak ; bericht\nVoorbeeld: /tell Bar ; Kom alsjeblieft 15 minuten eerder.\nEen datum vooraan kiest een andere avond: /tell 21.11. Bar ; …"

msgid "Message from %1$s: %2$s"
msgstr "Bericht van %1$s: %2$s"

msgid "No announcement is planned."
msgstr "Er is geen aankondiging gepland."

msgid "No blocked member called “%s” was found."
msgstr "Geen geblokkeerd lid met de naam ‘%s’ gevonden."

msgid "No newcomer called “%s” is waiting."
msgstr "Er wacht geen nieuwkomer met de naam ‘%s’."

msgid "No newcomer is waiting for an OK."
msgstr "Er wacht geen nieuwkomer op een OK."

msgid "No post-event email is planned."
msgstr "Er is geen e-mail na het evenement gepland."

msgid "No task called “%s” was found."
msgstr "Geen taak met de naam ‘%s’ gevonden."

msgid "Nobody else is on %s."
msgstr "Er staat verder niemand op %s."

