msgstr "Nu: %s"

msgid "Only organizers can use %s."
msgstr "Alleen organisatoren kunnen %s gebruiken."

msgid "Post"
msgstr "Plaatsen"

msgid "Post a new board in the group? The old one is removed."
msgstr "Een nieuw takenbord in de groep plaatsen? Het oude wordt verwijderd."

msgid "Recent tasks:"
msgstr "Recente taken:"

msgid "Reopen"
msgstr "Heropenen"

msgid "Reopen free entry for %s?"
msgstr "Gratis toegang voor %s weer openen?"

msgid "Send"
msgstr "Versturen"

msgid "Send link"
msgstr "Link sturen"

msgid "Send the night’s ticket emails now: /sendtickets (or /sendtickets 21.11.)\nCancel the waiting send: /sendtickets cancel"
msgstr "De ticketmails van de avond nu versturen: /sendtickets (of /sendtickets 21.11.)\nDe wachtende verzending annuleren: /sendtickets cancel"

#. translators: %s: a short day label, like "Sat 14 Nov".
msgid "Send the ticket emails for %s that have not gone out? They go out in about 10 minutes; until then you can cancel them."
msgstr "De ticketmails voor %s versturen die nog niet weg zijn? Ze gaan over ongeveer 10 minuten de deur uit; tot dan kun je ze annuleren."

#. translators: 1: number of people, 2: a task with its day and time.
msgid "Send this to %1$d person on %2$s?"
msgid_plural "Send this to %1$d people on %2$s?"
msgstr[0] "Dit naar %1$d persoon op %2$s sturen?"
msgstr[1] "Dit naar %1$d personen op %2$s sturen?"

#. translators: 1: people the message went to, 2: of them on Telegram, 3: of them by email.
msgid "Sent to %1$d person (Telegram %2$d, email %3$d)."
msgid_plural "Sent to %1$d people (Telegram %2$d, email %3$d)."
msgstr[0] "Verstuurd naar %1$d persoon (Telegram %2$d, e-mail %3$d)."
msgstr[1] "Verstuurd naar %1$d personen (Telegram %2$d, e-mail %3$d)."

msgid "Someone’s standing, credits and log: /standing name\nExample: /standing Milla"
msgstr "Status, credits en logboek van iemand: /standing naam\nVoorbeeld: /standing Milla"

msgid "Stop"
msgstr "Stoppen"

