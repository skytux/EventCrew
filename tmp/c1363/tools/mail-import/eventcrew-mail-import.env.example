# Settings for eventcrew-mail-import.py. Copy to /etc/eventcrew-mail-import.env,
# owned by root, group eventcrew-import, mode 0640: it holds two secrets.

# The mailbox organizers send their lists to (import@example.org).
IMAP_HOST=mail.example.org
IMAP_PORT=993
IMAP_USER=import@example.org
IMAP_PASSWORD=change-me

# Folders. Imported and Rejected are created on the first run if missing.
IMAP_FOLDER=INBOX
IMPORTED_FOLDER=Imported
REJECTED_FOLDER=Rejected

# The authserv-id at the start of the Authentication-Results header your mail
# server (Stalwart) adds, e.g. "mx.example.org". When set, only that header is
# trusted. When empty, the topmost Authentication-Results header is used.
AUTHSERV_ID=

# From wp-admin > EventCrew > Settings > Email > "Ticket buyer import by email".
IMPORT_URL=https://example.com/wp-json/eventcrew/v1/buyers-import
IMPORT_SECRET=change-me

# Optional: a URL fetched once per run, for a "did the poller run" monitor
# (healthchecks.io or similar). Leave empty for none.
PING_URL=
